# Copy this file to .env and fill in your own token. NEVER commit .env.
# GFW API token (free, requires a Global Fishing Watch account):
#   https://globalfishingwatch.org/our-apis/tokens
GFW_API_TOKEN=replace_with_your_own_global_fishing_watch_token

# Optional overrides (defaults come from config/config.yaml)
# GFW_API_BASE_URL=https://gateway.api.globalfishingwatch.org/v3/4wings/report
# HORMUZ_SAR_ARCHIVE_ROOT=D:/gfwdata
